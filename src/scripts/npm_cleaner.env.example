# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to npm_cleaner.env beside the script and set mode 0600.
NPM_CLEANER_LETSENCRYPT_DIR=/absolute/path/to/letsencrypt

# Keep one previous archive version in addition to the active version.
NPM_CLEANER_KEEP_OLD_VERSIONS=1
NPM_CLEANER_KEEP_CSR_DAYS=180
NPM_CLEANER_KEEP_KEYS_DAYS=180

# Set to 0 only after reviewing dry-run output.
NPM_CLEANER_DRY_RUN=1

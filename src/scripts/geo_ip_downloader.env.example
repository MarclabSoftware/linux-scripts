# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Optional sidecar: copy beside the script without .example, with mode 0600.
# When invoked by ip_blocker, its -c/-6/-o arguments own country selection,
# IPv6 and the output root. These three settings are standalone defaults only.
# Each provider can have its own country list; results are combined.
GEOIP_COUNTRIES='ripe:IT,FR;ipdeny:US,CA;nirsoft:DE'

# Optional settings:
# GEOIP_ALLOW_ROOT_DIR=/absolute/path/to/lists/allow/generated
# False skips IPv6 downloads/processing. Nirsoft is IPv4-only: with true,
# every selected provider must supply IPv6 country lists.
GEOIP_REQUIRE_IPV6=false
# GEOIP_MAX_DOWNLOAD_JOBS=4
# GEOIP_MAX_DOWNLOAD_RETRIES=3
# DNS_SERVERS='9.9.9.9 1.1.1.1'

# install_static_ffmpeg.sh configuration example
#
# Copy to install_static_ffmpeg.env beside the script. The real file is ignored
# by Git. Defaults support x86_64 and aarch64 Linux automatically.

# Values are consumed by install_static_ffmpeg.sh when sourced.
# shellcheck disable=SC2034

FFMPEG_INSTALL_DIR="/usr/local/bin"
FFMPEG_INSTALL_FFPLAY="1"

# Empty selects linux64 on x86_64 and linuxarm64 on aarch64. Set explicitly only
# when downloading for a different machine.
FFMPEG_BUILD_TARGET=""

# Optional HTTPS overrides. Leave empty to use the BtbN "latest" release.
FFMPEG_STATIC_URL=""
FFMPEG_CHECKSUMS_URL=""

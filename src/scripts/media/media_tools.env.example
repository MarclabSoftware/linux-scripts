# Shared configuration for the media maintenance scripts
#
# Copy to media_tools.env beside these scripts. The real file is ignored by
# Git. Empty MEDIA_LOG_FILE keeps logs on stderr only, which is the safest
# default for paths that may contain private filenames.

# Values are consumed by the media scripts when this file is sourced.
# shellcheck disable=SC2034

MEDIA_LOG_FILE=""
MEDIA_TEMP_ROOT="${TMPDIR:-/tmp}"

# Space-separated source extensions handled by convert_to_mp4.sh and
# archive_source_files.sh.
MEDIA_SOURCE_EXTENSIONS="avi wmv mmv mpg mpeg vob flv 3gp mts m2ts dv mov mkv"

MEDIA_VIDEO_CRF="14"
MEDIA_VIDEO_PRESET="veryslow"
MEDIA_AUDIO_BITRATE="320k"
MEDIA_IDET_FRAMES="200"
MEDIA_MIN_VIDEO_BYTES="10000"

# Preserve the original corrupt image as FILE.CORRUPT after a successful repair
# and rename unrepaired files to FILE.BROKEN.
MEDIA_KEEP_CORRUPT_ORIGINAL="1"
MEDIA_MARK_UNREPAIRABLE="1"

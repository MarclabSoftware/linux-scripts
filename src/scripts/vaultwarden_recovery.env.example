# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to vaultwarden_recovery.env beside the receiver and restore scripts.
# Restrict the installed file to its service account (mode 0600).
VAULTWARDEN_BACKUP_ROOT=/absolute/path/to/vaultwarden/backups
VAULTWARDEN_STANDBY_MOUNT=/absolute/path/to/stopped/standby/mount
VAULTWARDEN_STACK_DIR=/absolute/path/to/vaultwarden/stack

# Optional receiver settings:
# VAULTWARDEN_CONTAINER_LABEL=com.docker.compose.service=vaultwarden
# VAULTWARDEN_RETENTION_DAYS=7
# VAULTWARDEN_MAX_UPLOAD_MIB=20480

# Optional restore settings:
# VAULTWARDEN_DATA_DIR=/absolute/path/to/vaultwarden/stack/mnt/data
# VAULTWARDEN_COMPOSE_FILE=/absolute/path/to/vaultwarden/stack/compose.yaml
# VAULTWARDEN_SERVICE_NAME=vaultwarden
# VAULTWARDEN_HEALTH_TIMEOUT_SECONDS=60

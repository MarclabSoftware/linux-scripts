# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to webos_devmode.env beside the script and set mode 0600.
# The private key and real host address must not be committed.
WEBOS_HOST=192.0.2.10
WEBOS_PORT=9922
WEBOS_USERNAME=prisoner
WEBOS_PRIVATE_KEY=/absolute/path/to/webos_private_key

# Optional overrides:
# WEBOS_CONNECT_TIMEOUT=3
# WEBOS_REQUEST_TIMEOUT=10
# WEBOS_TOKEN_CACHE=/var/lib/webos_devmode/session_token
# WEBOS_KNOWN_HOSTS=/var/lib/webos_devmode/known_hosts
# WEBOS_API_URL=https://developer.lge.com/secure/ResetDevModeSession.dev

# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to update_debian.env beside the script and set mode 0600.
SYSTEM_UPDATE_BACKUP_ENABLED=1
SYSTEM_UPDATE_BACKUP_DIR=/absolute/path/to/backups
SYSTEM_UPDATE_BACKUP_PATHS_FILE=/absolute/path/to/update_debian.paths

# Optional maintenance tasks. Destructive Docker pruning is disabled by default.
SYSTEM_UPDATE_ASSUME_YES=1
SYSTEM_UPDATE_RPI_EEPROM=0
SYSTEM_UPDATE_JOURNAL_RETENTION=7d
SYSTEM_UPDATE_DOCKER_PRUNE=0
SYSTEM_UPDATE_DOCKER_PRUNE_VOLUMES=0
# SYSTEM_UPDATE_LOCK_FILE=/run/lock/update_debian.lock

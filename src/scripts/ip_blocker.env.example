# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to ip_blocker.env beside the script and set mode 0600.
# Country selection is intentionally required: choose the policy for this host.
# Each provider can have its own country list; results are combined.
IP_BLOCKER_COUNTRIES='ripe:IT,FR;ipdeny:US,CA;nirsoft:DE'

# Used only by the simple form, for example IP_BLOCKER_COUNTRIES='US,CA'.
# Advanced provider:country syntax ignores this setting.
IP_BLOCKER_PROVIDER=ipdeny
IP_BLOCKER_SSH_PORT=22

# Opt-in software offload. Select both ends of the forwarding path, then the
# interfaces allowed to INITIATE accelerated connections. Bridge ports are
# discovered automatically. DNAT/published services are never accelerated.
# Example Docker host: 'eth0 docker0 br-*' and 'docker0 br-*'.
# Example VPN + Docker host: 'eth0 wg0 docker0 br-*' and 'wg0 docker0 br-*'.
IP_BLOCKER_FLOWTABLE_INTERFACES=''
IP_BLOCKER_FLOWTABLE_TRUSTED_INTERFACES=''

# No NAT settings here. Docker owns container NAT; use the separately scoped
# wireguard_nat.nft.example for VPN egress if this host is a WireGuard exit.

IP_BLOCKER_USE_BLOCKLIST=false
IP_BLOCKER_GEOBLOCK_IPV6=false

# Keep the existing native table name when upgrading.
IP_BLOCKER_NFT_TABLE_NAME=ip_blocker

# Optional paths and early-boot DNS override. Real sources have bounded attempts;
# the systemd service retries failed runs, without a separate connectivity probe.
# IP_BLOCKER_LIST_DIR=/absolute/path/to/lists
# IP_BLOCKER_LOCK_DIR=/run/ip_blocker.lock
# DNS_SERVERS='9.9.9.9 1.1.1.1'

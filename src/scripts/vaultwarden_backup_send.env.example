# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to vaultwarden_backup_send.env beside the sender script and set mode 0600.
VAULTWARDEN_DATA_DIR=/absolute/path/to/vaultwarden/data
VAULTWARDEN_BACKUP_STATE_DIR=/absolute/path/to/backup/state
VAULTWARDEN_BACKUP_TARGET=backup-user@backup-host
VAULTWARDEN_BACKUP_SSH_KEY=/absolute/path/to/private/key
VAULTWARDEN_BACKUP_KNOWN_HOSTS=/absolute/path/to/known_hosts

# Optional overrides:
# VAULTWARDEN_BACKUP_SSH_PORT=22
# VAULTWARDEN_BACKUP_REMOTE_COMMAND=vaultwarden-backup

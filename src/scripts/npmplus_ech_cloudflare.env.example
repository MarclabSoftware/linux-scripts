# shellcheck shell=sh
# Private configuration for npmplus_ech_cloudflare.sh.
# shellcheck disable=SC2034

# Copy this file to npmplus_ech_cloudflare.env beside the deployed cron.sh,
# replace every placeholder and set mode 0600. Never commit the real file.

# Restrict the API token to Zone / Zone / Read and Zone / DNS / Edit for this
# zone only. The script resolves the IDs and creates the HTTPS record itself.
CF_API_TOKEN=replace-with-token
CF_ZONE=example.com

# Exact owner name for the HTTPS record. Use a wildcard here when the DNS
# layout is wildcard-based; with CNAME aliases, use their shared target.
ECH_RECORD_NAME=ech.example.com
# ECH_RECORD_NAME='*.proxy.example.com'

# The ECH outer SNI. It must be covered by the NPMplus certificate and should
# normally be shared by all proxied hostnames.
ECH_PUBLIC_NAME=public.example.com

# Safe, short basename for NPMplus current/previous ECH key files.
ECH_IDENTIFIER=shared

# Optional SvcParams placed before the generated ech parameter. Leave this
# unset when HTTP/3 is enabled and public TCP/UDP 443 reaches NPMplus; the shown
# value is the default. Remove h3 otherwise.
# ECH_SVC_PARAMS='alpn="h3,h2,http/1.1"'
# ECH_SVC_PARAMS='alpn="h2,http/1.1"'
# Add port only when clients use a non-standard public HTTPS port:
# ECH_SVC_PARAMS='alpn="h3,h2,http/1.1" port="8443"'
#
# The script owns the complete value, so configure every non-ECH parameter
# here rather than editing it in Cloudflare. Never add ech: it is generated.

# When absent, the script creates a DNS-only HTTPS record with priority 1,
# target "." and TTL 300. Later runs change data.value only, preserving any TTL
# adjustment made in Cloudflare.

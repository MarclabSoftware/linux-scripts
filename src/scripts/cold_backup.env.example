# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to cold_backup.env beside the script and restrict it to mode 0600.
# Leave a UUID empty to disable that backup target.

COLD_BACKUP_NVME_UUID=replace_with_filesystem_uuid
COLD_BACKUP_NVME_MOUNT=/absolute/mount/point
COLD_BACKUP_NVME_DATA_SOURCE=/absolute/source/directory/
COLD_BACKUP_NVME_BULK_DESTINATION=/data/
COLD_BACKUP_NVME_HOME_DESTINATION=/home/

COLD_BACKUP_HDD_UUID=replace_with_filesystem_uuid
COLD_BACKUP_HDD_MOUNT=/absolute/mount/point
COLD_BACKUP_HDD_DATA_SOURCE=/absolute/source/directory/
COLD_BACKUP_HDD_BULK_DESTINATION=/data/
COLD_BACKUP_HDD_HOME_DESTINATION=/home/

COLD_BACKUP_SOURCE_MOUNT=/absolute/source/mount
COLD_BACKUP_HOME_SOURCE=/absolute/home/source

# Optional:
# COLD_BACKUP_LOCK_FILE=/run/lock/cold_backup.lock

# Assignments are consumed by ethtool_optimizations.sh when this file is sourced.
# shellcheck disable=SC2034

# Space-separated shell patterns matched only below /sys/class/net.
ETHTOOL_INTERFACE_PATTERNS="en* eth*"

# Space-separated ethtool feature=state pairs.
ETHTOOL_FEATURE_SETTINGS="rx-udp-gro-forwarding=on"

# Normally unchanged. This override is useful in containers and tests.
ETHTOOL_SYSFS_NET_DIR="/sys/class/net"

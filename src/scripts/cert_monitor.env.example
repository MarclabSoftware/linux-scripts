# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to cert_monitor.env beside the script, replace the placeholders, and set
# mode 0600.
# Keep the real file outside the repository and restrict it to the service user.

# Required: choose the certificate directory for either NPM or NPMplus.
# NPM example:
CERT_MONITOR_SOURCE_DIR=/absolute/path/to/npm/letsencrypt/live/npm-1

# NPMplus example when its /data volume is mounted at /absolute/path/to/npmplus:
# CERT_MONITOR_SOURCE_DIR=/absolute/path/to/npmplus/tls/certbot/live/npm-1

# Required: destination PFX file.
CERT_MONITOR_OUTPUT=/absolute/path/to/technitium/certificate.pfx

# Optional overrides; the commented values are the built-in defaults.
# CERT_MONITOR_SETTLE_SECONDS=10
# CERT_MONITOR_OUTPUT_MODE=0600

# Optional: the service unit already supplies this value.
# CERT_MONITOR_LOCK_FILE=/run/cert_monitor/cert_monitor.lock

# Optional: configure only a file path, never a password value.
# Prefer LoadCredential= in the service unit when a password is required.
# CERT_MONITOR_PASSWORD_FILE=/absolute/path/to/pfx_password

# Assignments are consumed by another script when this file is sourced.
# shellcheck disable=SC2034

# Copy to docker_network.env beside the script and set mode 0600.
DOCKER_NETWORK_NAME=custom_bridge
DOCKER_NETWORK_DRIVER=bridge

# Leave subnet and gateway empty to let Docker allocate IPv4 automatically.
DOCKER_NETWORK_IPV4_SUBNET=
DOCKER_NETWORK_IPV4_GATEWAY=

# Set to 1 to enable IPv6. Empty IPv6 IPAM values let Docker allocate it.
DOCKER_NETWORK_ENABLE_IPV6=0
DOCKER_NETWORK_IPV6_SUBNET=
DOCKER_NETWORK_IPV6_GATEWAY=

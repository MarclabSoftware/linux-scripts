# update_zbdonglee.sh configuration example
#
# Copy this file to update_zbdonglee.env beside the script and keep that file
# private. Environment values may also be supplied directly for one-off runs.
# The defaults below document the script's normal, non-destructive behavior.

# Values are consumed by update_zbdonglee.sh when this file is sourced.
# shellcheck disable=SC2034

# Leave empty for automatic discovery through /dev/serial/by-id.
DEVICE=""
TARGET="auto"

# Firmware images. Pin releases deliberately and review upstream release notes
# before changing these URLs.
URL_ZBDONGLEE="https://github.com/Nerivec/silabs-firmware-builder/releases/download/v2026.6.0-pre1/sonoff_zbdonglee_zigbee_ncp_2026.6.0_9.1.0_115200_sw_flow.gbl"
URL_MG24="https://github.com/Nerivec/silabs-firmware-builder/releases/download/v2026.6.0-pre1/sonoff_dongle-pmg24_zigbee_ncp_2026.6.0_9.1.0_460800_sw_flow.gbl"

# Destructive values: none, nvm3, app or full. Any value other than none also
# requires RESET_CONFIRM=YES.
RESET_MODE="none"
RESET_CONFIRM=""
YES="0"

# Stop containers belonging to this Compose project while flashing.
STOP_Z2M="1"
COMPOSE_PROJECT="zigbee2mqtt"
RESTART_Z2M_ON_FLASH_FAILURE="0"

RECOVERY_REPO="Nerivec/silabs-firmware-recovery"
RECOVERY_RELEASE="latest"
RECOVERY_INCLUDE_PRERELEASES="1"

WORKDIR="${XDG_CACHE_HOME:-${HOME}/.cache}/zbdongle-flash"
MIN_FIRMWARE_BYTES="100000"
MIN_CLEAR_BYTES="10000"

# Optional absolute path to universal-silabs-flasher. When empty, the script
# searches universal-silabs-flasher, uvx and uv in that order.
FLASHER_BIN=""

[Unit]
Description=Atomically dump the Unbound DNS cache
# Instance: Unbound service and configuration name (normally "unbound").
# Example: unbound_cache_dump@unbound.service
Documentation=man:unbound-control(8)
After=%i.service
BindsTo=%i.service
ConditionPathExists=/run/%i/%i.ctl

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/var/lib/%i
UMask=0077

# Create the temporary file as the service account before systemd opens it for
# output. append: then preserves its ownership across every service command.
StandardOutput=append:/var/lib/%i/cache.dump.tmp
ExecStartPre=/usr/bin/install -m 0600 /dev/null /var/lib/%i/cache.dump.tmp
ExecStart=/usr/bin/unbound-control -s /run/%i/%i.ctl dump_cache
ExecStartPost=/usr/bin/mv -f /var/lib/%i/cache.dump.tmp /var/lib/%i/cache.dump
TimeoutStartSec=1min

CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/%i
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

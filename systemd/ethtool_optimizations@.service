[Unit]
Description=Apply configured ethtool optimizations
# Instance: Linux account that owns /home/<instance>/scripts.
# Example: ethtool_optimizations@service-user.service
Documentation=man:ethtool(8)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root

# The instance name selects the account whose scripts directory is used.
ExecStart=/home/%i/scripts/ethtool_optimizations.sh

CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

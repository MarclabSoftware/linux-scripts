[Unit]
Description=Update GeoIP firewall rules
# Instance: Linux account that owns /home/<instance>/scripts.
# Example: ip_blocker@service-user.service
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root

# The instance name selects the account whose scripts directory is used.
ExecStart=/home/%i/scripts/ip_blocker.sh
TimeoutStartSec=15min

# Firewall administration requires root and a narrow capability set.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# At early boot, the local DNS resolver (Technitium/systemd-resolved) may not
# be ready. DNS_SERVERS tells both scripts to resolve
# hostnames via these public DNS servers (dig/drill/host), bypassing the system
# resolver entirely for curl downloads.
#Environment=DNS_SERVERS="8.8.8.8 1.1.1.1"

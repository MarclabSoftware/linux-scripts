[Unit]
Description=Update the Unbound root hints
# Instance: Unbound service and configuration name (normally "unbound").
# Example: unbound_roothints@unbound.service
Documentation=man:unbound-checkconf(8) man:unbound-control(8)
Wants=network-online.target
Requires=%i.service
After=network-online.target %i.service
ConditionPathExists=/run/%i/%i.ctl

[Service]
Type=oneshot
UMask=0022

# Download into the destination directory, validate the basic root-zone
# structure, publish atomically, then ask Unbound to reload its configuration.
ExecStartPre=/usr/bin/rm -f /etc/%i/.root.hints.new
ExecStart=/usr/bin/curl --fail --silent --show-error --location --proto =https --tlsv1.2 --output /etc/%i/.root.hints.new https://www.internic.net/domain/named.cache
ExecStart=/usr/bin/test -s /etc/%i/.root.hints.new
ExecStart=/usr/bin/grep -Eq "^[.][[:space:]]+[0-9]+[[:space:]]+(IN[[:space:]]+)?NS[[:space:]]+" /etc/%i/.root.hints.new
ExecStart=/usr/bin/chmod 0644 /etc/%i/.root.hints.new
ExecStart=/usr/bin/mv -f /etc/%i/.root.hints.new /etc/%i/root.hints
ExecStart=/usr/bin/unbound-checkconf /etc/%i/unbound.conf
ExecStart=/usr/bin/unbound-control -s /run/%i/%i.ctl reload
ExecStopPost=-/usr/bin/rm -f /etc/%i/.root.hints.new
TimeoutStartSec=2min

CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/etc/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

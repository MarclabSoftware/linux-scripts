[Unit]
Description=Update the Unbound root hints
# Instance: Unbound service and configuration name (normally "unbound").
# Example: unbound_roothints@unbound.service
Documentation=man:unbound-checkconf(8) man:unbound-control(8)
Wants=network-online.target
Requires=%i.service
After=network-online.target %i.service
ConditionPathExists=/run/%i/%i.ctl

[Service]
Type=oneshot
UMask=0022

# Install src/scripts/unbound_update_root_hints.sh at this path with mode 0755.
# The helper retains the previous hints until configuration and reload succeed.
ExecStart=/usr/local/libexec/linux-scripts/unbound_update_root_hints.sh /etc/%i/root.hints /etc/%i/unbound.conf /run/%i/%i.ctl
TimeoutStartSec=2min

CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/etc/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
